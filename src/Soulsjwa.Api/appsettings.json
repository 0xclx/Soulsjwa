{
  "Jwt": {
    "Issuer": "soulsjwa",
    "Audience": "soulsjwa",
    "AccessTokenMinutes": "15",
    "RefreshTokenDays": "30"
  },
  "Frontend": {
    "Url": "http://localhost:5173"
  },
  "Media": {
    "RootPath": "/data/media"
  },
  "RateLimits": {
    "GlobalPerUserPerMinute": 100,
    "GlobalPerIpPerMinute": 60,
    "AuthPerIpPerMinute": 20,
    "ConnectorPerMinute": 120,
    "TwitchExtensionPerViewerPerMinute": 40
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "Soulsjwa.Api",
    "ServiceVersion": "1.0.0",
    "Endpoint": "http://localhost:4317",
    "ApiToken": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
