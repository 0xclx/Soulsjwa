<Window x:Class="Soulsjwa.Connector.GameDataViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Soulsjwa.Connector.Converters"
        mc:Ignorable="d"
        Title="{Binding GameName, StringFormat='Loaded game data — {0}'}"
        Height="600" Width="940"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:CategoryDisplayConverter x:Key="CategoryDisplay" />

        <!--
            Changed rows stay identifiable with the "changed since session start"
            filter switched off, so a value moving is visible while browsing the
            full catalog. Green matches the Start button in MainWindow.
        -->
        <Style x:Key="ValueCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChangedSinceBaseline}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#1B5E20" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <CollectionViewSource x:Key="GroupedPageItems" Source="{Binding PageItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Search (name, description, id)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"
                         Margin="0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding AvailableCategories}"
                          SelectedItem="{Binding SelectedCategoryOption}"
                          Padding="6,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Value, Converter={StaticResource CategoryDisplay}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Page size" Style="{StaticResource FieldLabel}" />
                <ComboBox SelectedValue="{Binding PageSize}" SelectedValuePath="Content" Padding="6,4">
                    <ComboBoxItem Content="25" />
                    <ComboBoxItem Content="50" />
                    <ComboBoxItem Content="100" />
                    <ComboBoxItem Content="200" />
                </ComboBox>
            </StackPanel>

            <CheckBox Grid.Column="3"
                      VerticalAlignment="Bottom"
                      Margin="12,0,0,6"
                      Content="Changed since session start"
                      IsChecked="{Binding ShowOnlyChangedSinceStart}"
                      IsEnabled="{Binding HasBaseline}"
                      ToolTip="Hides data points whose value has not moved since Start was pressed. Available only while a monitoring session is running." />
        </Grid>

        <!-- Results -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Source={StaticResource GroupedPageItems}}"
                  BorderThickness="1" BorderBrush="#DDD">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, Converter={StaticResource CategoryDisplay}}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Background="#EEEEEE" Padding="6,4" Margin="0,4,0,0" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="Value" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Value}" Style="{StaticResource ValueCell}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="At start" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding BaselineValue}" FontFamily="Consolas" Foreground="#666" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Category" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category, Converter={StaticResource CategoryDisplay}}" Foreground="#666" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Description" Width="280" DisplayMemberBinding="{Binding Description}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Pagination + counts -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="#666">
                <Run Text="{Binding TotalMatchingCount, Mode=OneWay}" />
                <Run Text=" of " />
                <Run Text="{Binding TotalPointCount, Mode=OneWay}" />
                <Run Text=" data point(s) match — " />
                <Run Text="{Binding ChangedSinceStartCount, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text=" changed since session start." />
            </TextBlock>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="◀ Previous"
                        Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource ActionButton}" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12">
                    <Run Text="Page " />
                    <Run Text="{Binding PageIndex, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" of " />
                    <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <Button Content="Next ▶"
                        Command="{Binding NextPageCommand}"
                        Style="{StaticResource ActionButton}"
                        Margin="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
