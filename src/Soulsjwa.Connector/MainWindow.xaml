<Window x:Class="Soulsjwa.Connector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:Soulsjwa.Connector.Behaviors"
        mc:Ignorable="d"
        Title="Soulsjwa Connector"
        Height="700" Width="900"
        MinHeight="550" MinWidth="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Configuration -->
        <GroupBox Grid.Row="0" Header="1. Configuration" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Server URL" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}" />

                <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" />
                <!--
                    The key is masked at rest so it cannot be read off a stream,
                    a screenshot or a screen recording. "Hold to show" swaps in a
                    read-only plain-text copy for exactly as long as the button is
                    held down (mouse or Space) — Button.IsPressed goes back to
                    False on release, on a drag off the button and on losing
                    capture, so the key can never be left uncovered by accident.
                -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <PasswordBox Grid.Column="0"
                                 behaviors:PasswordBoxBinding.Attach="True"
                                 behaviors:PasswordBoxBinding.BoundPassword="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox" BasedOn="{StaticResource SecretBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPressed, ElementName=RevealApiKeyButton}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>

                    <TextBox Grid.Column="0"
                             Text="{Binding ApiKey, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="False">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource InputBox}">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPressed, ElementName=RevealApiKeyButton}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button x:Name="RevealApiKeyButton"
                            Grid.Column="1"
                            Content="👁 Hold to show"
                            Style="{StaticResource ActionButton}"
                            Margin="8,0,0,0"
                            ToolTip="Shows the API key only while this button is held down (click and hold, or focus it and hold Space). Release it and the key is masked again, so it stays hidden while you are streaming or sharing your screen." />
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save Configuration"
                            Command="{Binding SaveConfigCommand}"
                            Style="{StaticResource ActionButton}" />
                    <Button Content="Connect"
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource ActionButton}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 2. Event + Game selection -->
        <GroupBox Grid.Row="1" Header="2. Event &amp; Game" Padding="10" Margin="0,0,0,10"
                  IsEnabled="{Binding IsConnected}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Event" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Events}"
                              SelectedItem="{Binding SelectedEvent}"
                              DisplayMemberPath="Name"
                              Padding="6,4" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Connector-supported game" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding SupportedGames}"
                              SelectedItem="{Binding SelectedGame}"
                              Padding="6,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding GameName, Mode=OneWay}" />
                                    <Run Text="{Binding KnownGameName, Mode=OneWay, StringFormat=' ({0})', TargetNullValue=''}" Foreground="#888" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Load game data"
                                Command="{Binding SelectGameCommand}"
                                Style="{StaticResource ActionButton}" />
                        <Button Content="View loaded data"
                                Command="{Binding ViewLoadedGameDataCommand}"
                                Style="{StaticResource ActionButton}"
                                ToolTip="Browse the data points loaded for the selected game (name, category, description) together with the value each one last read back. While a session runs, values refresh every poll tick and can be filtered down to the ones that changed since Start." />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 3. Start/Stop -->
        <GroupBox Grid.Row="2" Header="3. Live monitoring" Padding="10" Margin="0,0,0,10"
                  IsEnabled="{Binding IsConnected}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="▶ Start"
                            Command="{Binding StartCommand}"
                            Style="{StaticResource ActionButton}"
                            Background="#1B5E20" Foreground="White" />
                    <Button Content="■ Stop"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource ActionButton}" />
                    <Button Content="🔍 Debug"
                            Command="{Binding DebugReadCommand}"
                            Style="{StaticResource ActionButton}"
                            ToolTip="Read live process memory once and print the JSON payload here — without submitting anything to the server. Also fills in the values shown by &quot;View loaded data&quot;. Disabled while a session is running, since the poll already refreshes those values every couple of seconds." />
                    <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12">
                        <Run Text="Watching: " />
                        <Run Text="{Binding IsWatching, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="    " />
                        <Run Text="Completed this session: " />
                        <Run Text="{Binding CompletedThisSession, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="    " />
                        <Run Text="Failed: " />
                        <Run Text="{Binding FailedThisSession, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
                <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="#666"
                           TextWrapping="Wrap"
                           Text="The connector reads live process memory only — it never writes to it. State is polled every couple of seconds while Started and submitted whenever it changes (and at least every 30 s)." />
                <TextBlock Margin="0,8,0,2"
                           FontSize="12"
                           Text="Last debug payload (Debug button output, not submitted)">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LastDebugPayload}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox Text="{Binding LastDebugPayload, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MaxHeight="120">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LastDebugPayload}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>
        </GroupBox>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="10,6" Margin="0,0,0,4" CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E8F5E9" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#2E7D32" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="#C62828" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Loading overlay -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Loading..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16" />
        </Border>
    </Grid>
</Window>
