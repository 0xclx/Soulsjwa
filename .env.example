# Values consumed by the stock docker-compose.yml. The stack runs the api
# container as a deployment would (Production). To run it in Development
# instead: docker compose -f docker-compose.yml -f docker-compose.dev.yml up
POSTGRES_PASSWORD=<postgres-password>
JWT_SECRET=<at-least-32-ascii-characters>
TWITCH_CLIENT_ID=<your-twitch-client-id>
TWITCH_CLIENT_SECRET=<your-twitch-client-secret>

# Host port the api container is published on (container always listens on
# 8080 internally). Also used to derive the default Twitch__RedirectUri and
# Frontend__Url below, so changing it updates the app's public URL too.
API_PORT=8080

# ASP.NET Core host filtering. "*" (the default below) accepts any
# Host header — fine for local development, but a real deployment should
# name its actual hostname(s) here (comma-separated for more than one), e.g.
# ALLOWED_HOSTS=events.example.com. A non-Development start with this left
# at "*" logs a startup warning.
ALLOWED_HOSTS=*

# Direct .NET configuration keys (use these for dotnet run, custom Compose
# overrides, Kubernetes, or other hosts that pass environment variables straight
# to the API container). The stock docker-compose.yml derives its own
# Twitch__RedirectUri and Frontend__Url from API_PORT above instead of reading
# these two — update them to match if you're running one of those other hosts
# on a non-default port.
ConnectionStrings__DefaultConnection=<postgres-connection-string>
Jwt__Secret=<at-least-32-ascii-characters>
Jwt__Issuer=soulsjwa
Jwt__Audience=soulsjwa
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
Twitch__ClientId=<your-twitch-client-id>
Twitch__ClientSecret=<your-twitch-client-secret>
Twitch__RedirectUri=http://localhost:8080/api/v1/auth/twitch/callback
Frontend__Url=http://localhost:8080

# Optional Twitch extension backend (docs/twitch-extension.md). Leave all
# three empty to run without it. CLIENT_ID and SECRET come from the
# extension's page in the Twitch developer console (the secret as shown,
# base64); OWNER_USER_ID is the numeric Twitch user id of the account that
# owns the extension and enables push updates to viewers. The stock
# docker-compose.yml maps these to TwitchExtension__ClientId / __Secret /
# __OwnerUserId; for a rotation, set TwitchExtension__Secrets__0 and
# TwitchExtension__Secrets__1 directly instead of TwitchExtension__Secret.
TWITCH_EXTENSION_CLIENT_ID=
TWITCH_EXTENSION_SECRET=
TWITCH_EXTENSION_OWNER_USER_ID=

# Optional first-admin bootstrap. If set before any admin exists, the first
# matching Twitch login becomes Admin + allowlisted. Remove after bootstrap.
Admin__BootstrapTwitchLogin=

# Optional migration mode for non-Compose deployments. Docker Compose uses the
# dedicated `migrate` service instead.
APPLY_MIGRATIONS=false

# Retention: background cleanup of RefreshTokens (always on) and AuditLogs
# (opt-in). All four are optional; defaults shown.
#   Retention__IntervalHours=24            # how often a pass runs
#   Retention__RefreshTokenGraceDays=7     # days past ExpiresAt before a refresh
#                                           # token is deleted; a revoked-but-
#                                           # unexpired token always survives so
#                                           # reuse detection still fires for it
#   Retention__BatchSize=5000              # rows deleted per batch, per table
#   Retention__AuditRetentionDays=         # unset = keep audit rows forever;
#                                           # set a value to delete rows older
#                                           # than this many days (operator's
#                                           # policy call, not a code default)

# OpenTelemetry is off by default in Docker Compose — no traces, metrics, or
# OTLP export attempts unless you opt in. Set to true to enable it, and point
# OpenTelemetry__Endpoint (env var, or src/Soulsjwa.Api/appsettings.json) at
# your collector.
OpenTelemetry__Enabled=false

# JWT signing secret requirements:
#   - MUST be set; the API throws at startup if Jwt:Secret is missing.
#   - MUST be at least 32 ASCII characters (256 bits).
#   - SHOULD be generated from a cryptographically secure RNG, e.g.:
#       openssl rand -base64 48
#   - MUST be unique per deployment / environment. Never reuse example values in production.
#   - MUST NOT be committed to source control after copying this file to .env.
